# Stand role marker for operational visibility (`firewall` or `ipsec`).
AWG_MANAGER_STAND_PROFILE=firewall

# Persistent data directory (db/json/api key).
AWG_MANAGER_DATA_DIR=/etc/wg-manager

# Path to the encryption secret used by AWG Manager.
# Keep this aligned with AWG_MANAGER_DATA_DIR.
AWG_MANAGER_ENCRYPTION_KEY_FILE=/etc/wg-manager/encryption.key
